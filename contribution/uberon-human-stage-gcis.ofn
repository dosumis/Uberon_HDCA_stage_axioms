# somite existence starts during or after Carnegie stage 09 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "interval")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 08, absent] The embryo is presomitic, i.e., somites are not yet visible.")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0002329 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
    ObjectSomeValuesFrom(RO:0002496 HsapDv:0000016)
)

# stomodeum existence starts during Carnegie stage 09 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 09, start] The stomodeum is beginning to form.")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0000930 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
    ObjectSomeValuesFrom(RO:0002488 HsapDv:0000016)
)

# thymus primordium existence starts during Carnegie stage 13 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 13, start] Internal: septum primum and foramen primum appear in the heart; right and left lung buds are recognizable, and the trachea begins its development; retinal and lens discs appear; the endolymphatic appendage becomes distinguishable by the end of the stage.")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0005562 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
    ObjectSomeValuesFrom(RO:0002488 HsapDv:0000020)
)

# thyroid primordium existence starts during Carnegie stage 10 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 10, start] Although a sinus venosus as such is not present until the next stage, left and right sinusal horns appear during stage 10.")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0003091 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
    ObjectSomeValuesFrom(RO:0002488 HsapDv:0000017)
)

# ureteric bud existence starts during Carnegie stage 14 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 14, start] Internal: the ventral pancreas (if not detectable earlier) is distinguishable at stages 14 and 15; right and left lung sacs grow dorsad; the ureteric bud acquires a metanephrogenic cap; future cerebral hemispheres and cerebellar plates begin to be visible.  [Carnegie stage 13, present] A ureteric bud may possibly be present in some specimens (Wells, 1954, fig. 4), although further confirmation is needed.  [Carnegie stage 18, present] Collecting tubules develop from the calices at stages 17 and 18 (fig. 18-14).")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0000084 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
    ObjectSomeValuesFrom(RO:0002488 HsapDv:0000021)
)

)
