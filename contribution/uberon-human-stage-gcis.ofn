# primitive streak existence starts during Carnegie stage 06 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 06, start] In the human, the primitive streak appears first during stage 6.  [Carnegie stage 11, absent] The caudal eminence, which lies between the cloacal membrane and the site of the neurenteric canal, represents the region of the former primitive streak.")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
