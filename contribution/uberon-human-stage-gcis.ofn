# neural groove existence starts during Carnegie stage 08 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 08, start] The most advanced embryos with regard to endodermal spread are also more advanced in other respects. (Nos. 5960 and 7545 already show a neural groove.) It may be that this endoderm is derived from the caudal part of the primitive streak (fig. 6-2).")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0005061 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
