# Mullerian duct existence starts during Carnegie stage 16 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 16, start] The primordium of the paramesonephric duct is beginning to appear as an invagination of thickened coelomic epithelium over the mesonephros.")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0003890 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
    ObjectSomeValuesFrom(RO:0002488 HsapDv:0000023)
)

# amniotic cavity existence starts during Carnegie stage 05 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 05, start] Additional features of stage 5 include the definite appearance of the amniotic cavity and the formation of extra-embryonic mesoblast.")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0000301 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
    ObjectSomeValuesFrom(RO:0002488 HsapDv:0000009)
)

# atrial septum primum existence starts during Carnegie stage 13 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 13, start] Internal: septum primum and foramen primum appear in the heart; right and left lung buds are recognizable, and the trachea begins its development; retinal and lens discs appear; the endolymphatic appendage becomes distinguishable by the end of the stage.")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0004154 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
    ObjectSomeValuesFrom(RO:0002488 HsapDv:0000020)
)

# atrial septum secundum existence starts during Carnegie stage 18 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 18, start] Internal: in the heart, septum secundum and the associated foramen ovale are appearing; the membranous part of the interventricular septum is beginning to take form; the vomeronasal organ is represented by a groove; choanae develop; some subsegmental buds develop in the bronchial tree; collecting tubules develop from the calices; testicular cords may begin to appear in the male gonad; the paramesonephric duct grows rapidly down through the mesonephros; 1-3 semicircular ducts are present in the internal ear.")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0004155 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
    ObjectSomeValuesFrom(RO:0002488 HsapDv:0000025)
)

# chondrocranium existence starts during Carnegie stage 17 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 17, start] The cerebellar plate (innerer Kleinhirnwulst of Hochsetter) is present as a clear thickening.")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0002241 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
    ObjectSomeValuesFrom(RO:0002488 HsapDv:0000024)
)

# chorionic villus existence starts during Carnegie stage 06 [Homo sapiens]
SubClassOf(
    Annotation(TSA:onset_type "point")
    Annotation(RO:0002558 ECO:0000304)
    Annotation(rdfs:comment "[Carnegie stage 05, absent] Characteristic features: implanted but previllous; solid trophoblast in 5a; trophoblastic lacunae, cytotrophoblastic clumps, and primary umbilical vesicle in 5b; lacunar vascular circle and some mesoblastic crests in cytotrophoblastic clumps in 5c")
    Annotation(oboInOwl:hasDbXref "O'Rahilly R, Muller F (1987) Developmental Stages in Human Embryos. Carnegie Institution of Washington Publication 637")
    Annotation(dcterms:contributor "agent:stage-evidence")
    Annotation(dcterms:date "2026-10-10")
    ObjectIntersectionOf(UBERON:0007106 ObjectSomeValuesFrom(RO:0002162 NCBITaxon:9606))
    ObjectSomeValuesFrom(RO:0002488 HsapDv:0000011)
)

