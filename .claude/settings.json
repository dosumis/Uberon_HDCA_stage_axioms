{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify_evidence.py\" --pre",
            "timeout": 30,
            "statusMessage": "Verifying evidence against the source"
          }
        ]
      }
    ]
  }
}
